<Window x:Class="Manicotti.Views.PreviewAndBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Preview and Build" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        Topmost="True" MinWidth="350">
    <StackPanel Margin="15">
        <TextBlock Text="Analysis complete." FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBlock Text="A temporary preview has been drawn in the active view." TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ProgressBar IsIndeterminate="{Binding IsProcessing}" Height="5" Margin="0,0,0,5"/>
        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" Margin="0,0,0,10" FontStyle="Italic"/>

        <Expander Header="Diagnostics Report" Margin="0,10,0,0" IsExpanded="True">
            <Border BorderBrush="LightGray" BorderThickness="1" Padding="5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total Entities Analyzed:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Report.TotalEntities}" Margin="5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Walls Found:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Report.WallCount}" Margin="5" Foreground="Green"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Columns Found:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Report.ColumnCount}" Margin="5" Foreground="Goldenrod"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Doors / Windows Found:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Report.DoorCount}" Margin="5" Foreground="Blue"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Non-Zero Z Entities:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Report.NonZeroZCount}" Margin="5" Foreground="Red"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Duplicates Found:" FontWeight="Bold" Margin="5"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Report.DuplicateCount}" Margin="5" Foreground="Red"/>
                </Grid>
            </Border>
        </Expander>

        <TextBlock Text="Ready to build the permanent model?" TextWrapping="Wrap" Margin="0,20,0,15" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save Report..." Command="{Binding SaveReportCommand}" MinWidth="100" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Build Model" Command="{Binding BuildCommand}" IsDefault="True" MinWidth="100" Padding="10,5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="100" Margin="10,0,0,0" Padding="10,5"/>
        </StackPanel>
    </StackPanel>
</Window>
